{
  "name": "studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run mcp:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run && npm run mcp:test && npm run kit:validate",
    "tauri": "tauri",
    "postinstall": "npm --prefix mcp-server install",
    "mcp:build": "node scripts/mcp-prepare.mjs",
    "kit:validate": "npm run mcp:build && node scripts/kit.mjs validate",
    "kit:test": "npm run mcp:build && node scripts/kit.mjs test",
    "kit:try": "npm run mcp:build && node scripts/kit.mjs try",
    "kit:check": "npm run mcp:build && node scripts/kit.mjs check",
    "kit:schema": "npm run mcp:build && node scripts/kit.mjs schema",
    "ui:shots": "node scripts/ui-shots.mjs",
    "ui:a11y": "node scripts/ui-a11y.mjs",
    "ux:test": "node scripts/ux-test.mjs",
    "ux:menu": "node scripts/ux-menu-test.mjs",
    "ux:koppel": "node scripts/ux-koppel-test.mjs",
    "ux:supabase": "node scripts/ux-supabase-test.mjs",
    "ux:github": "node scripts/ux-github-test.mjs",
    "ux:vercel": "node scripts/ux-vercel-test.mjs",
    "ux:start": "node scripts/ux-start-check.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "setup:updates": "node scripts/setup-updates.mjs",
    "release": "node scripts/release.mjs",
    "mcp:test": "npm --prefix mcp-server test",
    "check": "npm run lint && npm test && npm run build && cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "flexlayout-react": "0.11.2",
    "i18next": "^27.1.3",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-resizable-panels": "^4.24.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
