{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio",
  "version": "0.1.0",
  "identifier": "nl.studio.app",
  "build": {
    "beforeDevCommand": "node scripts/dev-check.mjs && npm run mcp:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../mcp-server/dist/index.mjs": "mcp-server/index.mjs",
      "../design-packs": "design-packs",
      "../templates": "templates",
      "../mcp-server/node_modules/playwright-core": "mcp-server/node_modules/playwright-core"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQkRCN0U1REQ3MjJFQzAKUldUQUxuTGQ1YmU5anlhUkpFeTlOdmx2cEptYWF5WmNrZ1J5VGcxOGlQempnKzd1OTdEaUpyZmoK",
      "endpoints": [
        "https://github.com/GymWiki/Local-App-Builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
